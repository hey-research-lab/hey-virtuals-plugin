# GAME worker: optional. A HEY key lifts the anonymous rate limit and nothing else. Never commit a value.
HEY_API_KEY=

# ACP provider (seller): all empty until the founder registers the agent on app.virtuals.io.
# Nothing connects, registers or signs until HEY_ACP_ENABLE=1.
HEY_ACP_ENABLE=
HEY_ACP_WALLET_ADDRESS=
HEY_ACP_WALLET_ID=
HEY_ACP_SIGNER_PRIVATE_KEY=
# 8453 (Base) or 4663 (Robinhood Chain): the founder's decision.
HEY_ACP_CHAIN_ID=
# USDC per job; default 0. Pricing is the founder's decision; match the registry offering.
HEY_ACP_PRICE_USDC=
HEY_ACP_OFFERING_NAME=hey_builder_research
HEY_ACP_BUILDER_CODE=
